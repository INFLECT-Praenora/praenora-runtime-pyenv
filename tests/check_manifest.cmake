# Test bundle.manifest: the manifest of the bundle in BUNDLE agrees with the build, lists files
# that exist, and the bundle holds no excluded distribution and no file that names the build
# tree, the source tree or uv's cache where a consumer would read it; BioGears' binaries load no
# library from outside the bundle but the operating system's (docs/building.md#checking-a-bundle).
#
#   cmake -DBUNDLE=<dir> -DPACKAGE_NAME=<name> -DVERSION=<version> -DOS=<os> -DARCH=<arch>
#         -DCOMPILER_LABEL=<label> -DENGINES=<engines, separated by ','> -DPINS=<file>
#         -DBUILD_DIR=<dir> -DSOURCE_DIR=<dir> -DUV_CACHE_DIR=<dir>
#         [-DBIOGEARS_LIB_REL=<dir>] -P tests/check_manifest.cmake

cmake_minimum_required(VERSION 3.24)

foreach(_variable IN ITEMS BUNDLE PACKAGE_NAME VERSION OS ARCH COMPILER_LABEL PINS BUILD_DIR
                           SOURCE_DIR UV_CACHE_DIR)
    if(NOT DEFINED ${_variable} OR "${${_variable}}" STREQUAL "")
        message(FATAL_ERROR "${_variable} is not set")
    endif()
endforeach()
string(REPLACE "," ";" ENGINES "${ENGINES}")
include("${PINS}")

set(_failures 0)
function(_report ok what)
    if(ok)
        message(STATUS "ok: ${what}")
    else()
        message(STATUS "FAILED: ${what}")
        math(EXPR _count "${_failures} + 1")
        set(_failures ${_count} PARENT_SCOPE)
    endif()
endfunction()
macro(check_equal what actual expected)
    if("${actual}" STREQUAL "${expected}")
        _report(TRUE "${what} is '${expected}'")
    else()
        _report(FALSE "${what} is '${actual}', expected '${expected}'")
    endif()
endmacro()
macro(check_exists what path)
    if(EXISTS "${BUNDLE}/${path}")
        _report(TRUE "${what} exists: ${path}")
    else()
        _report(FALSE "${what} does not exist: ${path}")
    endif()
endmacro()

set(_manifest_file "${BUNDLE}/praenora-runtime-pyenv.json")
if(NOT EXISTS "${_manifest_file}")
    message(FATAL_ERROR "${_manifest_file} does not exist")
endif()
file(READ "${_manifest_file}" _manifest)
macro(_json out)
    string(JSON ${out} ERROR_VARIABLE _json_error GET "${_manifest}" ${ARGN})
    if(_json_error)
        set(${out} "<${_json_error}>")
    endif()
endmacro()

# Identity and labels.
_json(_value manifest_version)
check_equal("manifest_version" "${_value}" "1")
_json(_value name)
check_equal("name" "${_value}" "praenora-runtime-pyenv")
_json(_value version)
check_equal("version" "${_value}" "${VERSION}")
_json(_value package)
check_equal("package" "${_value}" "${PACKAGE_NAME}")
_json(_value platform os)
check_equal("platform.os" "${_value}" "${OS}")
_json(_value platform arch)
check_equal("platform.arch" "${_value}" "${ARCH}")
_json(_value compiler label)
check_equal("compiler.label" "${_value}" "${COMPILER_LABEL}")
_json(_value python version)
check_equal("python.version" "${_value}" "${PRAENORA_PYENV_PYTHON_VERSION}")
_json(_value python abi)
check_equal("python.abi" "${_value}" "${PRAENORA_PYENV_PYTHON_ABI}")
foreach(_member IN ITEMS home executable library include_dir site_packages)
    _json(_value python ${_member})
    check_exists("python.${_member}" "${_value}")
endforeach()

# Engines.
_json(_engines engines)
string(JSON _count LENGTH "${_engines}")
set(_names "")
if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE ${_last})
        string(JSON _name MEMBER "${_engines}" ${_index})
        list(APPEND _names "${_name}")
    endforeach()
endif()
# CMake's JSON functions keep object members in alphabetical order.
list(SORT _names)
set(_expected_engines ${ENGINES})
list(SORT _expected_engines)
check_equal("engines" "${_names}" "${_expected_engines}")
if(biogears IN_LIST ENGINES)
    _json(_value engines biogears runtime_dir)
    check_exists("engines.biogears.runtime_dir" "${_value}/states/StandardMale@0s.xml")
endif()

# Upstreams: pinned commits, modified as a boolean, license files.
foreach(_upstream IN LISTS PRAENORA_PYENV_UPSTREAMS)
    string(TOUPPER "${_upstream}" _up)
    string(REPLACE "-" "_" _up "${_up}")
    string(JSON _type ERROR_VARIABLE _missing TYPE "${_manifest}" upstreams ${_upstream})
    if(_missing)
        continue()  # an upstream that the enabled engines do not use
    endif()
    _json(_value upstreams ${_upstream} commit)
    check_equal("upstreams.${_upstream}.commit" "${_value}" "${PRAENORA_PYENV_${_up}_COMMIT}")
    string(JSON _type TYPE "${_manifest}" upstreams ${_upstream} modified)
    check_equal("upstreams.${_upstream}.modified type" "${_type}" "BOOLEAN")
endforeach()
_json(_value upstreams inflect-sim-core commit)
check_equal("upstreams.inflect-sim-core.commit" "${_value}"
    "${PRAENORA_PYENV_INFLECT_SIM_CORE_COMMIT}")

# License files: every file the manifest lists exists; every distribution has one, or is on the
# allow-list.
string(REGEX MATCHALL "\"licenses/[^\"]+\"" _licenses "${_manifest}")
list(LENGTH _licenses _count)
_report(_count "the manifest lists license files (${_count})")
foreach(_license IN LISTS _licenses)
    string(REPLACE "\"" "" _license "${_license}")
    if(NOT EXISTS "${BUNDLE}/${_license}")
        _report(FALSE "license file does not exist: ${_license}")
    endif()
endforeach()
_json(_distributions distributions)
string(JSON _count LENGTH "${_distributions}")
math(EXPR _last "${_count} - 1")
set(_installed "")
foreach(_index RANGE ${_last})
    string(JSON _name GET "${_distributions}" ${_index} name)
    string(JSON _source_${_name} GET "${_distributions}" ${_index} source)
    string(JSON _files GET "${_distributions}" ${_index} license_files)
    string(JSON _files_count LENGTH "${_files}")
    list(APPEND _installed "${_name}")
    set(_allowed FALSE)
    foreach(_entry IN LISTS PRAENORA_PYENV_LICENSE_ALLOWLIST)
        if(_entry MATCHES "^${_name}=")
            set(_allowed TRUE)
        endif()
    endforeach()
    if(_files_count EQUAL 0 AND NOT _allowed)
        _report(FALSE "distribution ${_name} has no license file and is not on the allow-list")
    endif()
endforeach()
_report(TRUE "${_count} distributions checked for license files")

# The distributions built from this checkout's submodules are recorded as local.
foreach(_name IN ITEMS simulation-core pybiogears)
    if(_name IN_LIST _installed)
        check_equal("source of ${_name}" "${_source_${_name}}" "local")
    endif()
endforeach()

# The installed inflect-sim-core is the submodule's code.
_json(_site python site_packages)
file(GLOB_RECURSE _modules RELATIVE "${SOURCE_DIR}/external/inflect-sim-core"
    "${SOURCE_DIR}/external/inflect-sim-core/viva_simulation_core/*.py")
set(_stale "")
foreach(_module IN LISTS _modules)
    file(SHA256 "${SOURCE_DIR}/external/inflect-sim-core/${_module}" _expected_hash)
    set(_installed_file "${BUNDLE}/${_site}/${_module}")
    if(NOT EXISTS "${_installed_file}")
        list(APPEND _stale "${_module} (missing)")
        continue()
    endif()
    file(SHA256 "${_installed_file}" _actual_hash)
    if(NOT _actual_hash STREQUAL _expected_hash)
        list(APPEND _stale "${_module}")
    endif()
endforeach()
list(LENGTH _modules _count)
if(_stale)
    list(JOIN _stale ", " _stale)
    _report(FALSE "installed viva_simulation_core differs from the submodule: ${_stale}")
else()
    _report(TRUE "the ${_count} modules of viva_simulation_core equal the submodule's")
endif()

# The oldest macOS the bundle needs is not newer than the deployment target it is built for.
if(OS STREQUAL "macos" AND DEFINED OSX_DEPLOYMENT_TARGET)
    _json(_min platform os_min_version)
    if(_min VERSION_GREATER OSX_DEPLOYMENT_TARGET)
        _report(FALSE "platform.os_min_version ${_min} is newer than the deployment target "
            "${OSX_DEPLOYMENT_TARGET}")
    else()
        _report(TRUE "platform.os_min_version ${_min} is at most ${OSX_DEPLOYMENT_TARGET}")
    endif()
endif()

# Excluded distributions.
_json(_excluded excluded)
string(JSON _count LENGTH "${_excluded}")
set(_names "")
math(EXPR _last "${_count} - 1")
foreach(_index RANGE ${_last})
    string(JSON _name GET "${_excluded}" ${_index})
    list(APPEND _names "${_name}")
    if(_name IN_LIST _installed)
        _report(FALSE "excluded distribution ${_name} is installed")
    endif()
endforeach()
check_equal("excluded" "${_names}" "${PRAENORA_PYENV_EXCLUDED_DISTRIBUTIONS}")

# No file that a consumer reads names the build tree, the source tree or uv's cache: the manifest,
# the CMake package, and the files of python/ but compiled binaries.
file(GLOB_RECURSE _files LIST_DIRECTORIES false "${BUNDLE}/python/*" "${BUNDLE}/lib/cmake/*")
list(APPEND _files "${_manifest_file}")
set(_offenders "")
foreach(_file IN LISTS _files)
    if(IS_SYMLINK "${_file}" OR
       _file MATCHES "\\.(so|dylib|dll|pyd|a|lib|exe|pyc|png|gif|jpg|ttf|afm|npz|npy|gz|zip)$" OR
       _file MATCHES "/bin/python3\\.[0-9]+$")
        continue()
    endif()
    file(STRINGS "${_file}" _hits REGEX "${BUILD_DIR}|${SOURCE_DIR}/external|${UV_CACHE_DIR}"
        LIMIT_COUNT 1)
    if(_hits)
        list(APPEND _offenders "${_file}")
    endif()
endforeach()
list(LENGTH _offenders _count)
if(_count EQUAL 0)
    _report(TRUE "no file names the build tree, the source tree or uv's cache")
else()
    list(JOIN _offenders "\n  " _offenders)
    _report(FALSE
        "${_count} file(s) name the build tree, the source tree or uv's cache:\n  ${_offenders}")
endif()

# BioGears' binaries, which the build links on this machine, load BioGears and Xerces-C from
# BIOGEARS_LIB_REL and nothing else from outside the bundle but the operating system's libraries.
# A library of the build machine (Homebrew's Xerces-C, a distribution's libxerces-c-3.2.so) would
# be found there and nowhere else.
if(biogears IN_LIST ENGINES AND OS MATCHES "^(macos|linux)$")
    if(NOT DEFINED BIOGEARS_LIB_REL OR BIOGEARS_LIB_REL STREQUAL "")
        message(FATAL_ERROR "BIOGEARS_LIB_REL is not set")
    endif()
    set(_lib_dir "${BUNDLE}/${BIOGEARS_LIB_REL}")
    file(GLOB _binaries LIST_DIRECTORIES false "${BUNDLE}/${_site}/pybiogears/*.so"
        "${_lib_dir}/*")
    set(_offenders "")
    set(_count 0)
    foreach(_binary IN LISTS _binaries)
        if(IS_SYMLINK "${_binary}")
            continue()
        endif()
        math(EXPR _count "${_count} + 1")
        get_filename_component(_binary_name "${_binary}" NAME)
        if(OS STREQUAL "macos")
            execute_process(COMMAND otool -L "${_binary}" OUTPUT_VARIABLE _output
                RESULT_VARIABLE _result ENCODING UTF-8)
            string(REPLACE "\n" ";" _lines "${_output}")
            list(REMOVE_AT _lines 0)
            foreach(_line IN LISTS _lines)
                if(NOT _line MATCHES "^[ \t]+([^ ]+) \\(")
                    continue()
                endif()
                set(_dependency "${CMAKE_MATCH_1}")
                if(_dependency MATCHES "^(/usr/lib|/System/Library)/")
                    continue()
                elseif(_dependency MATCHES "^@rpath/(.+)$" AND
                       EXISTS "${_lib_dir}/${CMAKE_MATCH_1}")
                    continue()
                endif()
                list(APPEND _offenders "${_binary_name}: ${_dependency}")
            endforeach()
        else()
            execute_process(COMMAND readelf -d "${_binary}" OUTPUT_VARIABLE _output
                RESULT_VARIABLE _result ENCODING UTF-8)
            string(REGEX MATCHALL "\\(NEEDED\\)[^\n]*\\[[^]\n]+\\]" _needed "${_output}")
            foreach(_entry IN LISTS _needed)
                string(REGEX REPLACE ".*\\[([^]]+)\\]$" "\\1" _dependency "${_entry}")
                if(_dependency MATCHES "^lib(biogears|xerces-c)" AND
                   NOT EXISTS "${_lib_dir}/${_dependency}")
                    list(APPEND _offenders "${_binary_name}: ${_dependency}")
                endif()
            endforeach()
        endif()
        if(NOT _result EQUAL 0)
            list(APPEND _offenders "${_binary_name}: not readable")
        endif()
    endforeach()
    if(_count EQUAL 0)
        _report(FALSE "no binary of BioGears found")
    elseif(_offenders)
        list(JOIN _offenders "\n  " _offenders)
        _report(FALSE "BioGears' binaries load libraries from outside the bundle:\n  ${_offenders}")
    else()
        _report(TRUE
            "the ${_count} binaries of BioGears load libraries of the bundle or the system")
    endif()
endif()

if(_failures GREATER 0)
    message(FATAL_ERROR "${_failures} check(s) failed")
endif()
