# PraenoraRuntimePyenvConfigVersion.cmake: version and platform check of the Python environment
# bundle @PRAENORA_PYENV_PACKAGE_NAME@.
#
# Generated by praenora-runtime-pyenv (@PRAENORA_PYENV_HOMEPAGE@).
#
# Version: a requested version is compatible when the bundle's version is at least that version
# and, for versions 0.x, has the same major and minor version, or, from 1.0, the same major
# version. Version ranges are honored. With no version requested, any version is compatible.
#
# Platform: the bundle is unsuitable, whatever its version, when the consuming project targets
# another operating system or architecture, or a macOS deployment target older than the bundle's,
# or, with MSVC, an older toolset than the one that built the bundle. The reasons are appended to
# the version that find_package reports for a configuration file it did not accept. The engines
# are components, which PraenoraRuntimePyenvConfig.cmake checks.

set(PACKAGE_VERSION "@PROJECT_VERSION@")

# Version.
set(_praenora_pyenv_version "${PACKAGE_VERSION}")
string(REGEX MATCH "^[0-9]+" _praenora_pyenv_major "${_praenora_pyenv_version}")
string(REGEX MATCH "^[0-9]+\\.([0-9]+)" _praenora_pyenv_minor "${_praenora_pyenv_version}")
set(_praenora_pyenv_minor "${CMAKE_MATCH_1}")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
if(PACKAGE_FIND_VERSION_RANGE)
    if(NOT _praenora_pyenv_version VERSION_LESS PACKAGE_FIND_VERSION_MIN AND
       ((PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE" AND
         NOT _praenora_pyenv_version VERSION_GREATER PACKAGE_FIND_VERSION_MAX) OR
        (PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "EXCLUDE" AND
         _praenora_pyenv_version VERSION_LESS PACKAGE_FIND_VERSION_MAX)))
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()
elseif(NOT PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
elseif(NOT _praenora_pyenv_version VERSION_LESS PACKAGE_FIND_VERSION)
    if(_praenora_pyenv_major EQUAL 0)
        if(PACKAGE_FIND_VERSION_MAJOR EQUAL 0 AND
           PACKAGE_FIND_VERSION_MINOR EQUAL _praenora_pyenv_minor)
            set(PACKAGE_VERSION_COMPATIBLE TRUE)
        endif()
    elseif(PACKAGE_FIND_VERSION_MAJOR EQUAL _praenora_pyenv_major)
        set(PACKAGE_VERSION_COMPATIBLE TRUE)
    endif()
    if(PACKAGE_FIND_VERSION VERSION_EQUAL _praenora_pyenv_version)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()

# Platform.
set(_praenora_pyenv_reasons "")
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(_praenora_pyenv_os macos)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(_praenora_pyenv_os windows)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_praenora_pyenv_os linux)
else()
    set(_praenora_pyenv_os "${CMAKE_SYSTEM_NAME}")
endif()
if(NOT _praenora_pyenv_os STREQUAL "@PRAENORA_PYENV_OS@")
    list(APPEND _praenora_pyenv_reasons "built for @PRAENORA_PYENV_OS@, not ${_praenora_pyenv_os}")
endif()

if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_OSX_ARCHITECTURES)
    set(_praenora_pyenv_arch "${CMAKE_OSX_ARCHITECTURES}")
elseif(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(_praenora_pyenv_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
else()
    set(_praenora_pyenv_arch "${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(_praenora_pyenv_arch MATCHES "^(x86_64|AMD64|amd64|x64)$")
    set(_praenora_pyenv_arch x86_64)
elseif(_praenora_pyenv_arch MATCHES "^(arm64|ARM64|aarch64)$")
    set(_praenora_pyenv_arch arm64)
endif()
if(NOT _praenora_pyenv_arch STREQUAL "@PRAENORA_PYENV_ARCH@")
    list(APPEND _praenora_pyenv_reasons
        "built for @PRAENORA_PYENV_ARCH@, not ${_praenora_pyenv_arch}")
endif()
if(DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    list(APPEND _praenora_pyenv_reasons "built for 64-bit targets")
endif()

if("@PRAENORA_PYENV_OS_MIN_VERSION_MEASURED@" AND CMAKE_OSX_DEPLOYMENT_TARGET AND
   CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS "@PRAENORA_PYENV_OS_MIN_VERSION_MEASURED@")
    list(APPEND _praenora_pyenv_reasons "needs CMAKE_OSX_DEPLOYMENT_TARGET \
@PRAENORA_PYENV_OS_MIN_VERSION_MEASURED@ or later, not ${CMAKE_OSX_DEPLOYMENT_TARGET}")
endif()

if("@PRAENORA_PYENV_MSVC_TOOLSET@" AND MSVC_TOOLSET_VERSION AND
   MSVC_TOOLSET_VERSION LESS "@PRAENORA_PYENV_MSVC_TOOLSET@")
    list(APPEND _praenora_pyenv_reasons "needs MSVC toolset @PRAENORA_PYENV_MSVC_TOOLSET@ or \
later, not ${MSVC_TOOLSET_VERSION}")
endif()

if(_praenora_pyenv_reasons)
    list(JOIN _praenora_pyenv_reasons "; " _praenora_pyenv_reasons)
    set(PACKAGE_VERSION
        "${PACKAGE_VERSION} (@PRAENORA_PYENV_PACKAGE_NAME@: ${_praenora_pyenv_reasons})")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()

unset(_praenora_pyenv_version)
unset(_praenora_pyenv_major)
unset(_praenora_pyenv_minor)
unset(_praenora_pyenv_os)
unset(_praenora_pyenv_arch)
unset(_praenora_pyenv_reasons)
