# PraenoraRuntimePyenvConfig.cmake: the Python environment bundle @PRAENORA_PYENV_PACKAGE_NAME@.
#
# Generated by praenora-runtime-pyenv (@PRAENORA_PYENV_HOMEPAGE@). It defines variables only, no
# targets. The engines are components: find_package(PraenoraRuntimePyenv ... COMPONENTS biogears)
# fails when the bundle does not hold a required engine. PraenoraRuntimePyenvConfigVersion.cmake
# refuses a bundle built for another platform (docs/outputs.md in praenora-runtime-pyenv).
#
# To embed the interpreter, give Python3_ROOT_DIR the value of PraenoraRuntimePyenv_PYTHON_HOME
# before find_package(Python3 ... COMPONENTS Development.Embed), and set the interpreter's home and
# executable to PraenoraRuntimePyenv_PYTHON_HOME and PraenoraRuntimePyenv_PYTHON_EXECUTABLE.

get_filename_component(PraenoraRuntimePyenv_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(PraenoraRuntimePyenv_MANIFEST "${PraenoraRuntimePyenv_ROOT}/praenora-runtime-pyenv.json")
set(PraenoraRuntimePyenv_PACKAGE_NAME "@PRAENORA_PYENV_PACKAGE_NAME@")

# Labels.
set(PraenoraRuntimePyenv_OS "@PRAENORA_PYENV_OS@")
set(PraenoraRuntimePyenv_ARCH "@PRAENORA_PYENV_ARCH@")
set(PraenoraRuntimePyenv_OS_MIN_VERSION "@PRAENORA_PYENV_OS_MIN_VERSION_MEASURED@")
set(PraenoraRuntimePyenv_COMPILER_ID "@PRAENORA_PYENV_COMPILER_ID@")
set(PraenoraRuntimePyenv_COMPILER_VERSION "@PRAENORA_PYENV_COMPILER_VERSION@")
set(PraenoraRuntimePyenv_COMPILER_LABEL "@PRAENORA_PYENV_COMPILER_LABEL@")
set(PraenoraRuntimePyenv_CXX_STDLIB "@PRAENORA_PYENV_CXX_STDLIB@")
set(PraenoraRuntimePyenv_MSVC_RUNTIME "@PRAENORA_PYENV_MSVC_RUNTIME@")
set(PraenoraRuntimePyenv_BUILD_TYPE "Release")

# The interpreter.
set(PraenoraRuntimePyenv_PYTHON_VERSION "@PRAENORA_PYENV_PYTHON_VERSION@")
set(PraenoraRuntimePyenv_PYTHON_ABI "@PRAENORA_PYENV_PYTHON_ABI@")
set(PraenoraRuntimePyenv_PYTHON_HOME
    "${PraenoraRuntimePyenv_ROOT}/@PRAENORA_PYENV_PYTHON_HOME_REL@")
set(PraenoraRuntimePyenv_PYTHON_EXECUTABLE
    "${PraenoraRuntimePyenv_ROOT}/@PRAENORA_PYENV_PYTHON_EXECUTABLE_REL@")
set(PraenoraRuntimePyenv_PYTHON_INCLUDE_DIR
    "${PraenoraRuntimePyenv_ROOT}/@PRAENORA_PYENV_PYTHON_INCLUDE_DIR_REL@")
set(PraenoraRuntimePyenv_PYTHON_LIBRARY
    "${PraenoraRuntimePyenv_ROOT}/@PRAENORA_PYENV_PYTHON_LIBRARY_REL@")
set(PraenoraRuntimePyenv_PYTHON_SITE_PACKAGES
    "${PraenoraRuntimePyenv_ROOT}/@PRAENORA_PYENV_PYTHON_SITE_PACKAGES_REL@")

# The engines, and BioGears' data directory when the bundle holds BioGears.
set(PraenoraRuntimePyenv_ENGINES "@PRAENORA_PYENV_ENGINES_RESOLVED@")
set(PraenoraRuntimePyenv_BIOGEARS_RUNTIME "")
if("biogears" IN_LIST PraenoraRuntimePyenv_ENGINES)
    set(PraenoraRuntimePyenv_BIOGEARS_RUNTIME
        "${PraenoraRuntimePyenv_ROOT}/@PRAENORA_PYENV_BIOGEARS_RUNTIME_REL@")
endif()

# The environment variables of a process that runs the bundle's Python, as NAME=value.
set(PraenoraRuntimePyenv_ENVIRONMENT
    "PYTHONHOME=${PraenoraRuntimePyenv_PYTHON_HOME}"
    "PYTHONNOUSERSITE=1"
    "PYTHONDONTWRITEBYTECODE=1"
    "PYTHONPATH="
    "PYTHONSAFEPATH=1")
if(PraenoraRuntimePyenv_BIOGEARS_RUNTIME)
    list(APPEND PraenoraRuntimePyenv_ENVIRONMENT
        "BIOGEARS_RUNTIME=${PraenoraRuntimePyenv_BIOGEARS_RUNTIME}")
endif()

# Components: the engines.
set(_praenora_pyenv_missing "")
foreach(_praenora_pyenv_component IN LISTS PraenoraRuntimePyenv_FIND_COMPONENTS)
    if(_praenora_pyenv_component IN_LIST PraenoraRuntimePyenv_ENGINES)
        set(PraenoraRuntimePyenv_${_praenora_pyenv_component}_FOUND TRUE)
    else()
        set(PraenoraRuntimePyenv_${_praenora_pyenv_component}_FOUND FALSE)
        if(PraenoraRuntimePyenv_FIND_REQUIRED_${_praenora_pyenv_component})
            list(APPEND _praenora_pyenv_missing "${_praenora_pyenv_component}")
        endif()
    endif()
endforeach()
if(_praenora_pyenv_missing)
    list(JOIN _praenora_pyenv_missing ", " _praenora_pyenv_missing)
    set(PraenoraRuntimePyenv_FOUND FALSE)
    set(PraenoraRuntimePyenv_NOT_FOUND_MESSAGE "the bundle \
${PraenoraRuntimePyenv_PACKAGE_NAME} does not hold the engine(s) ${_praenora_pyenv_missing}; it \
holds ${PraenoraRuntimePyenv_ENGINES}")
endif()
unset(_praenora_pyenv_component)
unset(_praenora_pyenv_missing)
