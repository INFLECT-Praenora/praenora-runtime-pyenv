# The bundle step and the archive.
#
# - The target pyenv_bundle (part of the default build) runs cmake/PraenoraPyenvBundle.cmake after
#   the installation of the Python environment. It checks the installed distributions, copies the
#   license files into licenses/, makes the bundle relocatable and writes the manifest
#   praenora-runtime-pyenv.json and the CMake package PraenoraRuntimePyenv (docs/outputs.md).
# - The target package (CPack) builds everything, then archives the bundle as
#   package/<package name>.tar.xz (.zip on Windows) in the build tree, with a top-level directory
#   of the same name and a .sha256 file beside it.

include_guard(GLOBAL)

# The inputs of the bundle script, written when they change.
if(MSVC)
    set(PRAENORA_PYENV_MSVC_TOOLSET "${MSVC_TOOLSET_VERSION}")
else()
    set(PRAENORA_PYENV_MSVC_TOOLSET "")
endif()
set(_praenora_pyenv_inputs "# Generated by cmake/PraenoraPyenvPackage.cmake: the inputs of \
cmake/PraenoraPyenvBundle.cmake.\n")
set(_praenora_pyenv_variables
    PROJECT_VERSION PROJECT_SOURCE_DIR PROJECT_BINARY_DIR PROJECT_HOMEPAGE_URL
    CMAKE_INSTALL_PREFIX
    PRAENORA_PYENV_PACKAGE_NAME PRAENORA_PYENV_OS PRAENORA_PYENV_ARCH
    PRAENORA_PYENV_OS_MIN_VERSION PRAENORA_PYENV_DISTRIBUTION PRAENORA_PYENV_COMPILER_ID
    PRAENORA_PYENV_COMPILER_VERSION PRAENORA_PYENV_COMPILER_LABEL PRAENORA_PYENV_CXX_STDLIB
    PRAENORA_PYENV_MSVC_RUNTIME PRAENORA_PYENV_MSVC_TOOLSET
    PRAENORA_PYENV_PYTHON_ARCHIVE PRAENORA_PYENV_PYTHON_SHA256
    PRAENORA_PYENV_PYTHON_HOME_REL PRAENORA_PYENV_PYTHON_EXECUTABLE_REL
    PRAENORA_PYENV_PYTHON_LIBRARY_REL PRAENORA_PYENV_PYTHON_INCLUDE_DIR_REL
    PRAENORA_PYENV_PYTHON_SITE_PACKAGES_REL
    PRAENORA_PYENV_RUST_VERSION PRAENORA_PYENV_XSD_VERSION PRAENORA_PYENV_UV_CACHE_DIR
    PRAENORA_PYENV_ENGINES_RESOLVED
    PRAENORA_PYENV_BIOGEARS_LIB_REL PRAENORA_PYENV_BIOGEARS_RUNTIME_REL)
foreach(_praenora_pyenv_engine IN LISTS PRAENORA_PYENV_KNOWN_ENGINES)
    string(TOUPPER "${_praenora_pyenv_engine}" _praenora_pyenv_engine_up)
    list(APPEND _praenora_pyenv_variables
        PRAENORA_PYENV_ENGINE_${_praenora_pyenv_engine_up}_DISTRIBUTION)
endforeach()
foreach(_praenora_pyenv_upstream IN LISTS PRAENORA_PYENV_UPSTREAMS)
    string(TOUPPER "${_praenora_pyenv_upstream}" _praenora_pyenv_up)
    string(REPLACE "-" "_" _praenora_pyenv_up "${_praenora_pyenv_up}")
    list(APPEND _praenora_pyenv_variables PRAENORA_PYENV_${_praenora_pyenv_up}_MODIFIED)
endforeach()
foreach(_praenora_pyenv_variable IN LISTS _praenora_pyenv_variables)
    string(APPEND _praenora_pyenv_inputs
        "set(${_praenora_pyenv_variable} [==[${${_praenora_pyenv_variable}}]==])\n")
endforeach()
set(PRAENORA_PYENV_BUNDLE_INPUTS "${PROJECT_BINARY_DIR}/bundle-config.cmake")
file(CONFIGURE OUTPUT "${PRAENORA_PYENV_BUNDLE_INPUTS}" CONTENT "${_praenora_pyenv_inputs}"
    @ONLY)

add_custom_target(pyenv_bundle ALL
    COMMAND "${CMAKE_COMMAND}" "-DCONFIG=${PRAENORA_PYENV_BUNDLE_INPUTS}"
        -P "${PROJECT_SOURCE_DIR}/cmake/PraenoraPyenvBundle.cmake"
    COMMENT "Checking the bundle and writing its licenses, manifest and CMake package"
    VERBATIM)
add_dependencies(pyenv_bundle pyenv_environment)
if(TARGET pyenv_biogears_bundle)
    add_dependencies(pyenv_bundle pyenv_biogears_bundle)
endif()

# The archive: the bundle directory as it is after the build.
set(CPACK_PACKAGE_NAME "praenora-runtime-pyenv")
set(CPACK_PACKAGE_VENDOR "INFLECT-Praenora")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "${PRAENORA_PYENV_PACKAGE_NAME}")
set(CPACK_PACKAGE_DIRECTORY "${PROJECT_BINARY_DIR}/package")
if(WIN32)
    set(CPACK_GENERATOR ZIP)
else()
    set(CPACK_GENERATOR TXZ)
endif()
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_INSTALLED_DIRECTORIES "${CMAKE_INSTALL_PREFIX};.")
set(CPACK_INSTALL_CMAKE_PROJECTS "")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_THREADS 0)
set(CPACK_SOURCE_GENERATOR "")
set(CPACK_VERBATIM_VARIABLES ON)
include(CPack)
